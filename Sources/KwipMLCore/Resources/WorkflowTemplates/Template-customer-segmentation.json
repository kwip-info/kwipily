      },
      "x": 0,
      "y": 0
    },
    {
      "address": {
        "domain": "data",
        "localID": "columns"
      },
      "name": "Declare types · retain audit fields",
      "payload": {
        "config": {
          "castFailure": "error",
          "missingPolicy": "error",
          "newColumns": "keep",
          "rows": [
            {
              "included": true,
              "outputName": "InvoiceNo",
              "source": "InvoiceNo",
              "targetType": "string"
            },
            {
              "included": true,
              "outputName": "StockCode",
              "source": "StockCode",
              "targetType": "string"
            },
            {
              "included": true,
              "outputName": "Description",
              "source": "Description",
              "targetType": "string"
            },
            {
              "included": true,
              "outputName": "Quantity",
              "source": "Quantity",
              "targetType": "int64"
            },
            {
              "included": true,
              "outputName": "InvoiceDate",
              "source": "InvoiceDate",
              "targetType": "string"
            },
            {
              "included": true,
              "outputName": "UnitPrice",
              "source": "UnitPrice",
              "targetType": "float64"
            },
            {
              "included": true,
              "outputName": "CustomerID",
              "source": "CustomerID",
              "targetType": "string"
            },
            {
              "included": true,
              "outputName": "Country",
              "source": "Country",
              "targetType": "string"
            }
          ],
          "trimText": true
        },
        "kind": "dataOperator",
        "operatorID": "kwip.data.columns"
      },
      "x": 250,
      "y": 0
    },
    {
      "address": {
        "domain": "data",
        "localID": "filter"
      },
      "name": "Positive purchases · exclude C invoices",
      "payload": {
        "config": {
          "column": "feature",
          "conditions": [
            {
              "caseSensitive": true,
              "column": "CustomerID",
              "comparison": "isNotMissing",
              "value": null
            },
            {
              "caseSensitive": true,
              "column": "CustomerID",
              "comparison": "ne",
              "value": ""
            },
            {
              "caseSensitive": true,
              "column": "Quantity",
              "comparison": "gt",
              "value": 0
            },
            {
              "caseSensitive": true,
              "column": "UnitPrice",
              "comparison": "gt",
              "value": 0
            },
            {
              "caseSensitive": false,
              "column": "InvoiceNo",
              "comparison": "notContains",
              "value": "C"
            }
          ],
          "expression": "[feature] > 0",
          "flags": [],
          "match": "all",
          "matchMode": "search",
          "mode": "simple",
          "nullPolicy": "nonmatching",
          "pattern": ".+"
        },
        "kind": "dataOperator",
        "operatorID": "kwip.data.filterRows"
      },
      "x": 500,
      "y": 0
    },
    {
      "address": {
        "domain": "data",
        "localID": "line_amount"
      },
      "name": "Calculate line amount",
      "payload": {
        "config": {
          "operations": [
            {
              "expression": "[Quantity] * [UnitPrice]",
              "id": "line-amount",
              "nullPolicy": "error",
              "outputs": [
                {
                  "dtype": "float64",
                  "name": "LineAmount",
                  "write": "new"
                }
              ]
            }
          ]
        },
        "kind": "dataOperator",
        "operatorID": "kwip.data.formula"
      },
      "x": 750,
      "y": 0
    },
    {
      "address": {
        "domain": "data",
        "localID": "invoices"
      },
      "name": "Sum each customer invoice",
      "payload": {
        "config": {
          "aggregations": [
            {
              "column": "LineAmount",
              "nullPolicy": "error",
              "op": "sum",
              "output": "InvoiceAmount"
            }
          ],
          "groupBy": [
            "CustomerID",
            "InvoiceNo"
          ],
          "maxRows": 100000,
          "nullKeys": "error"
        },
        "kind": "dataOperator",
        "operatorID": "kwip.data.aggregate"
      },
      "x": 1000,
      "y": 0
    },
    {
      "address": {
        "domain": "data",
        "localID": "customers"
      },
      "name": "Count purchases and sum GBP",
      "payload": {
        "config": {
          "aggregations": [
            {
              "op": "countRows",
              "output": "PurchaseCount"
            },
            {
              "column": "InvoiceAmount",
              "nullPolicy": "error",
              "op": "sum",
              "output": "PurchaseAmount"
            }
          ],
          "groupBy": [
            "CustomerID"
          ],
          "maxRows": 100000,
          "nullKeys": "error"
        },
        "kind": "dataOperator",
        "operatorID": "kwip.data.aggregate"
      },
      "x": 1250,
      "y": 0
    },
    {
      "address": {
        "domain": "data",
        "localID": "units"
      },
      "name": "Fixed units · 10 purchases and 100 GBP",
      "payload": {
        "config": {
          "operations": [
            {
              "expression": "[PurchaseCount] / 10",
              "id": "frequency-units",
              "nullPolicy": "error",
              "outputs": [
                {
                  "dtype": "float64",
                  "name": "FrequencyPer10Purchases",
                  "write": "new"
                }
              ]
            },
            {
              "expression": "[PurchaseAmount] / 100",
              "id": "amount-units",
              "nullPolicy": "error",
              "outputs": [
                {
                  "dtype": "float64",
                  "name": "AmountPer100GBP",
                  "write": "new"
                }
              ]
            }
          ]
        },
        "kind": "dataOperator",
        "operatorID": "kwip.data.formula"
      },
      "x": 1500,
      "y": 0
    },
    {
      "address": {
        "domain": "control",
        "localID": "segments"
      },
      "name": "Exploratory K-means · k4 seed42",
      "payload": {
        "config": {
          "algorithm": "kmeans",
          "backendID": "sklearn",
          "featureColumns": [
            "FrequencyPer10Purchases",
            "AmountPer100GBP"
          ],
          "operation": "fit",
          "settings": {
            "clusters": 4,
            "initializations": 10,
            "maxIterations": 200,
            "seed": 42,
            "tolerance": 0.0001
          },
          "targetColumn": "",
          "task": "prebuilt"
        },
        "kind": "estimator"
      },
      "x": 1750,
