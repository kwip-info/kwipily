  "modelSourceVersions": {},
  "name": "Explore customer purchase groups",
  "nodes": [
    {
      "address": {
        "domain": "data",
        "localID": "source"
      },
      "name": "Purchase records",
      "payload": {
        "config": {
          "commentPrefix": "",
          "emptyField": "text",
          "encoding": "utf-8-sig",
          "format": "csv",
          "headerMode": "firstRecord",
          "ignoreErrors": false,
          "inferSchema": false,
          "nullMarkers": [],
