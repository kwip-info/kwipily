      "runtimeContract": {
        "version": {
          "major": 1,
          "minor": 0,
          "patch": 0
        },
        "adapterID": "kwip.runner.graph-v2.batch_norm1d",
        "graphSchemaVersions": [
          2
        ],
        "inputSampleRanks": [
          1,
          2
        ],
        "channelAxis": 1,
        "channelMinimum": 1,
        "channelMaximum": 512,
        "spatialMinimum": 1,
        "spatialMaximum": 4096,
        "preservesBatch": true,
        "graphDTypes": [
          "float32"
        ],
        "epsilonMinimum": 1.1754943508222875e-38,
        "epsilonMaximum": 3.4028234663852886e+38,
        "affineModes": [
          false,
          true
        ],
        "biasModes": [
          false,
          true
        ],
        "forwardVarianceCorrection": 0,
        "maximumTensorElements": 100000000,
        "momentumMinimum": 0.0,
        "momentumMaximum": 1.0,
        "trackingModes": [
          false,
          true
        ],
        "runningVarianceCorrection": 1,
        "runningMeanDType": "float32",
        "runningVarianceDType": "float32",
        "counterDType": "int64",
        "counterMaximum": 1000000000,
        "statisticsScope": "batchSpatial",
        "evaluationUsesRunningStatisticsWhenTracked": true,
        "averagingModes": [
          "moving",
          "cumulative"
        ],
        "counterBehavior": "trainingCalls",
        "minimumCurrentStatisticsMembers": 2
      },
      "learning": {
        "contentVersion": 1,
        "updatedAt": "2026-10-08",
        "exampleID": "prepared-batch-norm1d-classifier",
        "sourceResource": "workflow-observations",
        "title": "Explore BatchNorm1d in a classifier",
        "subtitle": "Center and scale values across observations and spatial positions for each channel.",
        "disclosureTitle": "Current groups and remembered summaries",
        "formula": "Center and scale values across observations and spatial positions for each channel.",
        "paragraphs": [
          "An observation is one independent example. A channel is a parallel measurement or grid. Normalization centers a chosen group around its average and adjusts its spread. This block compares values across observations and spatial positions for each channel.",
          "Channels declares the architecture’s channel count; it must match the connected array. Safety value is a small positive cushion used when dividing by spread. Learned scale multiplies each channel; optional learned shift adds an adjustment. The array shape stays the same.",
          "Track running statistics stores a remembered mean and spread during training. Evaluation uses those saved summaries without changing them. When tracking is disabled, evaluation uses current input groups too. Running-stat update weight chooses how much the latest summary replaces the remembered one; it is not optimizer momentum.",
          "Moving summary uses the configured update weight. Cumulative summary gives each training call equal weight and keeps a batches-seen counter. Changing the batch can change current BatchNorm results because observations share statistics."
        ],
        "buttonTitle": "Open BatchNorm1d example",
        "exampleSource": "Sources/KwipMLCore/StatefulNormalizationWorkflowExample.swift",
        "lessonIDs": [
          "assessment.batch-norm1d-current-group",
          "assessment.batch-norm1d-remembered-summary"
        ]
      }
    },
