      "presentation": {
        "theme": "mauve",
        "icon": "layer_norm-v2",
        "shortTitle": "LayerNorm",
        "purpose": "Center and scale chosen trailing dimensions within each observation. Optionally learn scale and shift for each position."
      },
      "outputConditions": {},
      "sources": {
        "native": "Sources/KwipMLCore/LayerNormComponent.swift",
        "worker": "runner/graph_semantics.py",
        "tests": "runner/tests/test_layer_norm_execution.py",
        "evidence": "docs/production/TORCH_LAYER_NORM.md"
      },
      "runtimeContract": {
        "version": {
          "major": 1,
          "minor": 0,
          "patch": 0
        },
        "adapterID": "kwip.runner.graph-v2.layer_norm",
        "graphSchemaVersions": [
          2
        ],
        "maximumRank": 8,
        "preservesBatch": true,
        "epsilonMinimum": 1.1754943508222875e-38,
        "epsilonMaximum": 3.4028234663852886e+38,
        "elementwiseAffineModes": [
          false,
          true
        ],
        "biasModes": [
          false,
          true
        ],
        "varianceCorrection": 0,
        "usesCurrentInputStatistics": true
      },
      "learning": {
        "contentVersion": 1,
        "updatedAt": "2026-10-08",
        "exampleID": "prepared-layer-norm-classifier",
        "sourceResource": "workflow-observations",
        "title": "Explore LayerNorm in a classifier",
        "subtitle": "Compare normalization within feature groups and across a whole observation.",
        "disclosureTitle": "How LayerNorm compares values",
        "formula": "Center each chosen group around zero, then scale its spread. Learned scale and shift are optional.",
        "paragraphs": [
          "Trailing sample dimensions choose which values share a mean and spread. A mean is the average; spread measures how far values sit from it. Separate observations never share these statistics.",
          "Epsilon is a small positive safety value that keeps constant groups usable. Scale and bias are learned adjustments for each position; bias has no effect when learning scale is disabled.",
          "Compare the grouped and whole-sample examples. They preserve array shape but compare different groups of values. This uses current inputs, rather than fitting statistics from a dataset.",
          "With CPU float32 numbers, values clustered near a large common offset can lose precision in learning sensitivities. Use a training-fitted centering or scaling step before the model, then apply the same fitted transform to held-out data. This is a numerical limit of the pinned backend, not a reason to mix observations."
        ],
        "buttonTitle": "Open editable grouped LayerNorm flow",
        "exampleSource": "Sources/KwipMLCore/LayerNormExample.swift"
      }
    },
