        "seed": 42,
        "validationPercent": 20,
        "testPercent": 20,
        "stratifyColumn": "label"
      }
    },
    {
      "id": "prepare",
      "operator": "kwip.data.preprocess",
      "config": {
        "mode": "partitions",
        "columns": [
          {
            "column": "amount",
            "missing": "error",
            "value": 0,
            "emptyPolicy": "error",
            "emptyValue": 0,
            "tiePolicy": "error",
            "encoding": "none",
            "vocabularyOrder": "lexicographic",
            "unknownPolicy": "error",
            "maxCategories": 32,
            "scaling": "standard",
            "center": true,
            "unitVariance": true,
            "unicodeNormalization": "none",
            "removeControls": false,
            "removePunctuation": false,
            "removeDigits": false,
            "whitespace": "none",
            "case": "preserve",
            "emptyAfterCleanup": "keep"
          },
          {
            "column": "temperature",
            "missing": "error",
            "value": 0,
            "emptyPolicy": "error",
            "emptyValue": 0,
            "tiePolicy": "error",
            "encoding": "none",
            "vocabularyOrder": "lexicographic",
            "unknownPolicy": "error",
            "maxCategories": 32,
            "scaling": "standard",
            "center": true,
            "unitVariance": true,
            "unicodeNormalization": "none",
            "removeControls": false,
            "removePunctuation": false,
            "removeDigits": false,
            "whitespace": "none",
            "case": "preserve",
            "emptyAfterCleanup": "keep"
          }
        ]
