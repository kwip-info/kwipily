{
  "schemaVersion": 1,
  "nodes": [
    {
      "id": "source",
      "operator": "kwip.data.sourceCSV",
      "config": {
        "separator": ","
      }
    },
    {
      "id": "columns",
      "operator": "kwip.data.columns",
      "config": {
        "rows": [
