            "source": "reading_raw",
            "included": true,
            "outputName": "amount",
            "targetType": "float64"
          },
          {
            "source": "temperature",
            "included": true,
            "outputName": "temperature",
            "targetType": "float64"
          },
          {
            "source": "quality",
            "included": true,
            "outputName": "quality",
