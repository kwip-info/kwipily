      "operator": "kwip.data.filterRows",
      "config": {
        "mode": "simple",
        "conditions": [
          {
            "column": "quality",
            "comparison": "eq",
            "value": "accepted",
            "caseSensitive": true
          }
        ],
        "match": "all",
        "expression": "",
        "column": "quality",
        "pattern": ".+",
        "matchMode": "search",
        "flags": [],
        "nullPolicy": "error"
      }
    },
    {
      "id": "range-filter",
      "operator": "kwip.data.filterRows",
      "config": {
        "mode": "simple",
        "conditions": [
          {
            "column": "amount",
            "comparison": "ge",
            "value": 0,
            "caseSensitive": true
          }
        ],
        "match": "all",
        "expression": "",
        "column": "amount",
        "pattern": ".+",
        "matchMode": "search",
        "flags": [],
        "nullPolicy": "error"
      }
    },
    {
      "id": "model-columns",
      "operator": "kwip.data.columns",
      "config": {
        "rows": [
          {
            "source": "amount",
            "included": true,
            "outputName": "amount",
            "targetType": "keep"
          },
          {
            "source": "temperature",
            "included": true,
            "outputName": "temperature",
            "targetType": "keep"
          },
          {
            "source": "label",
