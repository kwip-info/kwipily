          },
          {
            "source": "sample_id",
            "included": true,
            "outputName": "sample_id",
            "targetType": "keep"
          }
        ],
        "castFailure": "error",
        "trimText": false,
        "newColumns": "drop",
        "missingPolicy": "error"
      }
    },
    {
