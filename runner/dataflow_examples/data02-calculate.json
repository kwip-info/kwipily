{
  "schemaVersion": 1,
  "nodes": [
    {
      "id": "source",
      "operator": "kwip.data.sourceCSV",
      "config": {
        "separator": ","
      }
    },
    {
      "id": "cast",
      "operator": "kwip.data.columns",
      "config": {
        "rows": [
          {
            "source": "order_id",
            "included": true,
            "outputName": "order_id",
            "targetType": "keep"
          },
          {
            "source": "customer",
            "included": true,
            "outputName": "customer",
            "targetType": "keep"
          },
          {
            "source": "email",
            "included": true,
            "outputName": "email",
            "targetType": "keep"
          },
          {
            "source": "quantity",
            "included": true,
            "outputName": "quantity",
            "targetType": "int64"
          },
          {
            "source": "unit_price",
            "included": true,
            "outputName": "unit_price",
            "targetType": "float64"
          },
          {
            "source": "note",
            "included": true,
            "outputName": "note",
            "targetType": "keep"
          }
        ],
        "castFailure": "error",
        "trimText": false,
        "newColumns": "keep",
        "missingPolicy": "preserve"
      }
    },
    {
      "id": "tool",
      "operator": "kwip.data.formula",
      "config": {
        "operations": [
          {
            "id": "practice-formula",
            "expression": "[quantity] * [unit_price]",
            "outputs": [
              {
                "name": "order_total",
                "dtype": "float64",
                "write": "new"
              }
            ],
            "nullPolicy": "error"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "source",
        "port": "table"
      },
      "to": {
        "node": "cast",
        "port": "table"
      }
    },
    {
      "from": {
        "node": "cast",
        "port": "table"
      },
      "to": {
        "node": "tool",
        "port": "table"
      }
    }
  ]
}
